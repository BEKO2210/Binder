{
  "expo": {
    "name": "Binder",
    "slug": "binder",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Binder to use your location while discovering nearby people."
        }
      ]
    ],
    "android": {
      "package": "de.beko2210.binder",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F"
      }
    },
    "ios": {
      "bundleIdentifier": "de.beko2210.binder",
      "supportsTablet": false
    }
  }
}
