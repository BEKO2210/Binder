{
  "expo": {
    "name": "Binder",
    "slug": "binder",
    "scheme": "binder",
    "extra": {
      "eas": {
        "projectId": "167de5e7-e72f-4fcd-bc7c-379513ff2b21"
      }
    },
    "version": "0.7.4",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#090A0F",
    "icon": "./assets/brand/icon.png",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Binder to use your location while discovering nearby people."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "binder_new_message_sound_vibrate_v1",
          "icon": "./assets/brand/monochrome.png",
          "color": "#C7FF4A",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/manrope/400Regular/Manrope_400Regular.ttf",
            "node_modules/@expo-google-fonts/manrope/500Medium/Manrope_500Medium.ttf",
            "node_modules/@expo-google-fonts/manrope/700Bold/Manrope_700Bold.ttf",
            "node_modules/@expo-google-fonts/manrope/800ExtraBold/Manrope_800ExtraBold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090A0F",
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#090A0F",
            "image": "./assets/brand/splash-icon.png"
          }
        }
      ],
      "expo-system-ui",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "android": {
      "package": "de.beko2210.binder",
      "icon": "./assets/brand/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/monochrome.png",
        "backgroundColor": "#090A0F"
      },
      "googleServicesFile": "./google-services.json",
      "versionCode": 57,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "binder",
              "host": "reset-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.CAMERA"
      ],
      "allowBackup": false
    },
    "ios": {
      "bundleIdentifier": "de.beko2210.binder",
      "icon": "./assets/brand/icon.png",
      "supportsTablet": false
    }
  }
}
