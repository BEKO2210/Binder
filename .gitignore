node_modules/
.expo/
dist/
web-build/
android/
ios/
.env
.env.*
!.env.example
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
*.keystore
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Deterministically materialized by scripts/materialize-brand-assets.mjs
assets/brand/icon.png
assets/brand/adaptive-foreground.png
assets/brand/monochrome.png
assets/brand/splash-icon.png

# Prepared only for the static GitHub Pages artifact
site/assets/
# ...except the script that decides the visitor's language: it is source, not a
# generated brand asset, and the site is broken without it.
!site/assets/language.js

# EAS keystore credentials (Klartext-Passwoerter) — Repo ist public
credentials.json
supabase/.temp/
artifacts/*
# …except the record of what was actually released. It is small, contains no
# secrets, and is the only thing tying a shipped file to the commit it came from.
!artifacts/release-evidence/
# The coverage floors are a promise about the code, not an output: they belong
# in the diff where raising or lowering one can be argued about.
!artifacts/coverage-floors.json
# The verdict itself: which artefact was judged ready, on what evidence.
!artifacts/release-candidate/
# The performance baseline is a promise, like the coverage floors: raising it
# has to be arguable in a diff.
!artifacts/performance-baseline.json
# What a phone actually downloads, measured from the last bundle. A test holds
# it under the size where downloads start to hurt, and a test that reads a file
# only some machines have is not a test — it passed here and failed on a fresh
# checkout, which is the whole reason this line exists.
!artifacts/delivery-size-report.json


# The code map belongs in the repo so any agent can find its way; the browser
# view and the extractor's cache do not — one is a megabyte of generated HTML,
# the other is scratch.
graphify-out/graph.html
graphify-out/cache/

# Local tool logs: a firebase-debug.log carried the owner's address and every
# project id in the account into a public repository.
firebase-debug.log
firebase-debug.*.log
*-debug.log

# The audit report the gate reads: generated per run, never committed.
npm-audit.json
