{
  "name": "binder",
  "version": "0.7.43",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "brand:assets": "node scripts/materialize-brand-assets.mjs",
    "site:prepare": "node scripts/prepare-site.mjs",
    "postinstall": "node scripts/materialize-brand-assets.mjs",
    "prestart": "node scripts/materialize-brand-assets.mjs",
    "start": "expo start",
    "preandroid": "node scripts/materialize-brand-assets.mjs",
    "android": "expo run:android",
    "preios": "node scripts/materialize-brand-assets.mjs",
    "ios": "expo run:ios",
    "preweb": "node scripts/materialize-brand-assets.mjs",
    "web": "expo start --web",
    "release": "node scripts/release-build.mjs",
    "typecheck": "tsc --noEmit",
    "prebundlecheck": "node scripts/materialize-brand-assets.mjs",
    "bundlecheck": "expo export --platform android --output-dir dist",
    "mail:templates": "node scripts/build-email-templates.mjs",
    "verify:mail-templates": "node scripts/build-email-templates.mjs --check",
    "site:languages": "node scripts/build-site-languages.mjs",
    "verify:site-languages": "node scripts/build-site-languages.mjs --check",
    "verify:brand": "node scripts/verify-brand-assets.mjs",
    "verify:phase6-design": "node scripts/verify-phase6-design.mjs",
    "verify:phase6-settings": "node scripts/verify-phase6-settings.mjs",
    "verify:phase6-media": "node scripts/verify-phase6-media.mjs",
    "verify:phase7-push": "node scripts/verify-phase7-push.mjs",
    "verify:admin": "node scripts/verify-admin-dashboard.mjs",
    "verify:design-contract": "node scripts/verify-design-contract.mjs",
    "test": "node --experimental-strip-types --test 'tests/*.test.ts'",
    "typecheck:tests": "tsc --project tsconfig.tests.json",
    "test:design-contract": "npm run verify:design-contract",
    "verify:worklets": "node scripts/verify-worklet-contract.mjs",
    "i18n:sync": "node scripts/i18n-sync.mjs",
    "push:copy": "node scripts/build-push-copy.mjs",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "i18n:coverage": "node scripts/verify-i18n-coverage.mjs",
    "verify:i18n-coverage": "node scripts/verify-i18n-coverage.mjs",
    "site:i18n": "node scripts/build-site-i18n.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "0.4.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@shopify/react-native-skia": "2.6.2",
    "@supabase/supabase-js": "2.112.3",
    "aes-js": "^3.1.2",
    "expo": "~57.0.8",
    "expo-audio": "~57.0.3",
    "expo-build-properties": "~57.0.12",
    "expo-constants": "57.0.11",
    "expo-crypto": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-manipulator": "~57.0.5",
    "expo-image-picker": "~57.0.5",
    "expo-linear-gradient": "~57.0.1",
    "expo-location": "~57.0.5",
    "expo-notifications": "~57.0.6",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-url-polyfill": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
